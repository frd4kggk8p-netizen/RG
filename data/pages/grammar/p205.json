      ],
      "margin_number": null,
      "speaker": null,
      "text": "First aorist infinitive middle",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "box",
