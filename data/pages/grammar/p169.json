        684,
        665
      ],
      "margin_number": null,
      "speaker": null,
      "text": "Second aorist active participles: stem + endings",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "paragraph",
      "order": 11,
      "bbox": [
        691,
        185,
        725,
        906
      ],
      "margin_number": 170,
      "speaker": null,
      "text": "The second aorist active participle is formed by adding the endings -ών -οῦσ-α -όν to the aorist stem:",
      "lang": "en",
      "para_no": 3,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "box",
      "order": 12,
      "bbox": [
        737,
        185,
        905,
        907
      ],
      "margin_number": null,
      "speaker": null,
      "text": "λαβ-ών λαβ-οῦσα λαβ-όν (λαβ-οντ-), ‘taking’, ‘on taking’, ‘having taken’\n(λαμβάνω)\ns.\nm.\nf.\nn.\nNom.\nλαβ-ών\nλαβ-οῦσ-α\nλαβ-όν\nAcc.\nλαβ-όντ-α\nλαβ-οῦσ-αν\nλαβ-όν\nGen.\nλαβ-όντ-ος\nλαβ-ούσ-ης\nλαβ-όντ-ος\nDat.\nλαβ-όντ-ι\nλαβ-ούσ-ῃ\nλαβ-όντ-ι",
      "lang": "mixed",
