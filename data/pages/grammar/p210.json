      "bbox": [
        456,
        194,
        495,
        915
      ],
      "margin_number": 203,
      "speaker": null,
      "text": "δεινός means ‘clever at –ing’ when followed by the infinitive, e.g. δεινή ἐστι λέγειν ‘she is clever at speaking’",
      "lang": "mixed",
      "para_no": 203,
      "marker": null,
      "table": null,
      "exercise": null,
