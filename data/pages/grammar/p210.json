        915
      ],
      "margin_number": 202,
      "speaker": null,
      "text": "You have already met δεῖ (and χρή), which mean ‘must, ought’ and take an accusative and infinitive (153):",
      "lang": "en",
      "para_no": 202,
      "marker": null,
      "table": null,
      "exercise": null,
