      "bbox": [
        431,
        194,
        447,
        482
      ],
      "margin_number": null,
      "speaker": null,
      "text": "δεινός (+ infinitive) ‘clever at’",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
