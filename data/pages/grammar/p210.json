      "bbox": [
        272,
        246,
        292,
        829
      ],
      "margin_number": null,
      "speaker": null,
      "text": "δεῖ με πρὸς τὰς Ἀθήνας πλεῖν ‘I must/ought to sail to Athens’",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
