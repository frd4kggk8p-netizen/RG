      ],
      "margin_number": 173,
      "speaker": null,
      "text": "αὐτός is one of very few pronouns in Greek which (like the def. art.) end in -ο in the n. s. nom./acc. You have already met others: e.g. οὗτος and ἐκεῖνος (69).",
      "lang": "mixed",
      "para_no": 173,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
