        743,
        532
      ],
      "margin_number": 174,
      "speaker": null,
      "text": "αὐτός has a variety of meanings:",
      "lang": "mixed",
      "para_no": 174,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
