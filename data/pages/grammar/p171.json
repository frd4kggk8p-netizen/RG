      "bbox": [
        759,
        186,
        775,
        389
      ],
      "margin_number": null,
      "speaker": null,
      "text": "‘Him’, ‘her’, ‘it’, ‘them’",
      "lang": "en",
      "para_no": null,
      "marker": "■",
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "paragraph",
      "order": 11,
      "bbox": [
        784,
        186,
        819,
        907
      ],
      "margin_number": null,
      "speaker": null,
      "text": "Used as an unstressed pronoun, but never in the nom. (nor as the first word of a clause, when it will always mean ‘self’) αὐτός means ‘him’, ‘her’, ‘them’, e.g.",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
