        726,
        882,
        753
      ],
      "margin_number": null,
      "speaker": "ΔΙΚ.",
      "text": "οὐκ ἂν δυναίμεθα, ὦ φίλε, σῶσαί σε. φυλάττουσι γάρ σε οἱ οἰκεῖοι πάντες, καὶ οὐκ ἔξεστί σοι φυγεῖν.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
