      ],
      "margin_number": null,
      "speaker": "ΔΙΚΑΣΤΑΙ",
      "text": "τίς γάρ ἐστιν ὁ ἐγκλείων σε; λέξον, αἰτοῦμέν σε.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 17,
      "bbox": [
        228,
        599,
        817,
        629
      ],
      "margin_number": null,
      "speaker": "ΦΙΛ.",
      "text": "ὁ ἐμὸς υἱός, εὖ ἴστε. ἀλλὰ μὴ βοᾶτε. καὶ γὰρ τυγχάνει οὗτοσὶ πρόσθεν καθεύδων.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
