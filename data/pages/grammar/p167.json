          {
            "n": "b",
            "prompt": "With a glance at me the teacher began to speak. (βλέπω)"
          },
          {
            "n": "c",
            "prompt": "The spectators heard his arguments and applauded. (ἀκούω)"
          },
          {
            "n": "d",
            "prompt": "Dionysodoros replied with laughter constantly in his voice. (γελάω: aor. stem γελασα-)"
          },
          {
            "n": "e",
            "prompt": "The woman picked up the argument and replied. (ἐκδέχομαι)"
          },
          {
            "n": "f",
            "prompt": "He happened to say in answer. (ἀποκρίνομαι: aor. stem ἀποκρινα-)"
          }
        ]
      },
