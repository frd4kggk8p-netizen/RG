      "bbox": [
        886,
        246,
        899,
        892
      ],
      "margin_number": null,
      "speaker": null,
      "text": "ἀνα-χωρέω ‘I retreat’ ἀνα-χωρησ- → ἀν-ε-χώρησα ‘I retreated’",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
