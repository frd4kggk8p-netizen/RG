      "order": 10,
      "bbox": [
        726,
        185,
        805,
        907
      ],
      "margin_number": null,
      "speaker": null,
      "text": "The s. active imperative form in -(σ)ον (cf. from the Mass, Κύριε, ἐλέησον, Χριστέ, ἐλέησον ‘Lord, have mercy, Christ, have mercy!’) – the absence of α makes this look strange as a first aorist form cf. 130(a);",
      "lang": "mixed",
      "para_no": null,
      "marker": "bullet",
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
