        185,
        907,
        715
      ],
      "margin_number": null,
      "speaker": null,
      "text": "Observe once again the familiar first aorist stem in -(σ)α-. Note particularly carefully:",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
