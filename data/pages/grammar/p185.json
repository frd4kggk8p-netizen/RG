      ],
      "margin_number": 184,
      "speaker": null,
      "text": "The forms of the present optative active and middle for non-contract verbs are as follows:",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
