        735
      ],
      "margin_number": null,
      "speaker": null,
      "text": "λέγοιμι ἄν ‘I would/would like to/can/will tell you.’",
      "lang": "mixed",
      "para_no": null,
      "marker": "bullet",
      "table": null,
      "exercise": null,
