        757
      ],
      "margin_number": 211,
      "speaker": null,
      "text": "Note the first three principal parts of the following verbs:\nαἱρέω, ‘I take, capture, condemn’, and its middle, αἱρέομαι, ‘I take for myself,\nchoose’;\nπάσχω, ‘I suffer, experience, have something happen to me’;\nφέρω, ‘I carry, bear, put up with’;\nπείθω, ‘I persuade’, and its middle, πείθομαι, ‘I trust, obey’.",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
