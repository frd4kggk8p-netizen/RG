        678,
        908
      ],
      "margin_number": null,
      "speaker": "BDELYKLEON",
      "text": "Once and for all, father, listen and obey me. I shall not allow you to leave the house and judge in the courtroom.",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 28,
      "bbox": [
        684,
        219,
        715,
        908
      ],
      "margin_number": null,
      "speaker": "PHILOKLEON",
      "text": "Why aren't I allowed to? I expect you to tell me everything.",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
