        778,
        219,
        810,
        907
      ],
      "margin_number": null,
      "speaker": "BDEL.",
      "text": "I shall allow you to pass judgement here in the house. Would you like that?",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
