        772,
        908
      ],
      "margin_number": null,
      "speaker": "PHIL.",
      "text": "Well, what am I allowed to do? What do you intend to do?",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
