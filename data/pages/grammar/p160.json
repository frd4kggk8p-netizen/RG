      "bbox": [
        195,
        704,
        916,
        737
      ],
      "margin_number": 163,
      "speaker": null,
      "text": "The first aorist active participle is formed by adding the following endings to the aorist stem: -(α)ς -(α)σ-α -(α)ν -(α)ντ-, e.g.",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "box",
      "order": 13,
      "bbox": [
        193,
        749,
        916,
        935
      ],
      "margin_number": null,
      "speaker": null,
      "text": "παύσα-ς παύσα-σ-α παύσα-ν (παυσα-ντ-) ‘having stopped, on stopping,\nstopping’\ns.\nm.\nf.\nn.\nNom. παύσᾱ-ς παύσᾱ-σ-α παῦσα-ν\nAcc. παύσα-ντ-α παύσᾱ-σ-αν παῦσα-ν\nGen. παύσα-ντ-ος παυσᾱ-σ-ης παύσα-ντ-ος\nDat. παύσα-ντ-ι παυσᾱ-σ-ῃ παύσα-ντ-ι",
      "lang": "mixed",
