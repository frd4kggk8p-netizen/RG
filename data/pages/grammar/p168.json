        506,
        811,
        523
      ],
      "margin_number": null,
      "speaker": null,
      "text": "‘πρὸς τὸν ἰατρὸν ᾖα,’ ἦν δ᾽ ἐγώ, ‘ἦσαν δὲ ἐνταῦθα καὶ οἱ φίλοι. ᾔδει γὰρ ὁ",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
