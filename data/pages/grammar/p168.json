      "margin_number": null,
      "speaker": null,
      "text": "‘φέρε δή,’ ἔφη ὁ Σωκράτης, ‘ἐπειδὴ ἡ νόσος ἀνέπιπτε καὶ διέφθειρε τὴν\nπόλιν, ποῖ ᾔεισθα σύ, πότερον πρὸς τοὺς φίλους, ἢ πρὸς τὸν ἰατρόν;’",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
