        915
      ],
      "margin_number": null,
      "speaker": null,
      "text": "ἀνίσταμαι ‘I leave’\nἀνίσταμαι ‘I leave’\nἀνίστασαι ‘you (s.) leave’\nἀνίσταται ‘he/she/it leaves’\nἀνιστάμεθα ‘we leave’\nἀνίστασθε ‘you (pl.) leave’\nἀνίστανται ‘they leave’\nInfinitive\nἀνίστασθαι ‘to leave’\nParticiple\nἀνιστάμενος η ον ‘leaving’",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
