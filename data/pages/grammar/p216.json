      "bbox": [
        507,
        193,
        578,
        915
      ],
      "margin_number": null,
      "speaker": null,
      "text": "The present/second aorist pl. form (in -όντων) and the first aorist pl. form (in -[σ]άντων) could be mistaken for present and aorist participles in the gen. pl.!",
      "lang": "en",
      "para_no": null,
      "marker": "•",
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
