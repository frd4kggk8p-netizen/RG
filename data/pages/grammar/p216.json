        715
      ],
      "margin_number": null,
      "speaker": null,
      "text": "(b) Third person imperatives are fairly rare, but note that:",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
