      ],
      "margin_number": null,
      "speaker": null,
      "text": "Non-contract verbs form their infinitives as follows. Note the thematic vowel -ε-:",
      "lang": "en",
      "para_no": 2,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "box",
      "order": 9,
      "bbox": [
        581,
        193,
        747,
        917
      ],
      "margin_number": null,
      "speaker": null,
      "text": "Active infinitive, -ειν\nAdd -ειν to the present stem, e.g.\nπαύω, ‘I stop’ > παύ-ειν, ‘to stop’\nMiddle infinitive, -εσθαι\nAdd -εσθαι to the present stem, e.g.\nπαύομαι, ‘I stop (myself)’ > παύ-εσθαι, ‘to stop (oneself)’, ‘cease’",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
