      "margin_number": null,
      "speaker": null,
      "text": "212. You have already met the present optative active (-οιμι -οις -οι, etc., 184).\nHere is the aorist optative active:",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "box",
