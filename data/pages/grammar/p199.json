      "order": 13,
      "bbox": [
        693,
        248,
        752,
        907
      ],
      "margin_number": null,
      "speaker": null,
      "text": "τῇ ὑστεραίᾳ ἀπῆλθεν ‘he left on the following day’\nἐπανῆλθε τῇ τρίτῃ ἡμέρᾳ ‘he returned on the third day’, i.e. two days later",
      "lang": "mixed",
      "para_no": 7,
      "marker": null,
