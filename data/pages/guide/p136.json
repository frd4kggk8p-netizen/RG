      "bbox": [
        658,
        193,
        672,
        694
      ],
      "margin_number": null,
      "speaker": null,
      "text": "λαβεῖν What is it? Try the principal parts of λαμβάνω.",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
