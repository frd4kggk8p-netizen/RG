      "speaker": null,
      "text": "λήψῃ What tense? What person? What verb? Try the future of λαμβάνω.",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
