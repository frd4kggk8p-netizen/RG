      "margin_number": 1,
      "speaker": null,
      "text": "ἐρωτῶσιν οὖν τινες ‘some people ask, therefore ...’: a typical rhetorical device which allows the speaker to pose the question which he wants to answer.",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
