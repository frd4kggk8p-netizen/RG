        759,
        853
      ],
      "margin_number": null,
      "speaker": null,
      "text": "d. ἀνάγκη ἦν Σωκράτη ἰέναι πρὸς τοὺς σοφοὺς καὶ διαλέγεσθαι περὶ σοφίας.\nIt was necessary for Socrates to go to the wise men and talk about wisdom [with them].",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": {
        "id": "1b",
        "instruction": null,
        "items": [
          {
            "n": "d",
            "prompt": "ἀνάγκη ἦν Σωκράτη ἰέναι πρὸς τοὺς σοφοὺς καὶ διαλέγεσθαι περὶ σοφίας.\nIt was necessary for Socrates to go to the wise men and talk about wisdom [with them]."
