      ],
      "margin_number": null,
      "speaker": null,
      "text": "νεανίας ἐπειρᾶτο αὐτὸν πεῖσαι μὴ δικάζειν, ὁ δὲ γέρων αὐτῷ οὐκ ἐπείθετο",
      "lang": "grc",
      "para_no": null,
