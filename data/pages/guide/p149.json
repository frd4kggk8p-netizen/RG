    },
    {
      "type": "passage_line",
      "order": 6,
      "bbox": [
        262,
        89,
        275,
        836
      ],
      "margin_number": null,
      "speaker": "ΒΔΕΛΥΚΛΕΩΝ",
      "text": "ἄκουσον γάρ, ὦ πάτερ, καὶ ἐμοὶ πιθοῦ. οὐ γάρ ἐάσσω σε λιπόντα τὴν",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 7,
      "bbox": [
        277,
        191,
        287,
        574
      ],
      "margin_number": null,
      "speaker": null,
      "text": "οἰκίαν ἐν τῷ δικαστηρίῳ δικάζειν.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 8,
      "bbox": [
        291,
        89,
        301,
        796
      ],
      "margin_number": null,
      "speaker": "ΦΙΛΟΚΛΕΩΝ",
      "text": "ἀλλὰ διὰ τί οὐκ ἐάσεις ἐμέ; ἐλπίζω γὰρ σέ μοι πάντα λέξειν.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 9,
      "bbox": [
        305,
        89,
        316,
        526
      ],
      "margin_number": null,
      "speaker": "ΒΔΕΛ.",
      "text": "διότι πονηρότατος εἶ τῶν ἐν τῇ πόλει.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 10,
      "bbox": [
        320,
        89,
        331,
        560
      ],
      "margin_number": null,
      "speaker": "ΦΙΛ.",
      "text": "τί οὖν ἐάσεις με ποιεῖν; τί μέλλεις ποιήσειν;",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 11,
      "bbox": [
        335,
        89,
        345,
        856
      ],
      "margin_number": null,
      "speaker": "ΒΔΕΛ.",
      "text": "ἔξεσταί σοι δικάζειν ἐνθάδε ἐν τῇ οἰκίᾳ. ταῦτα δὲ βούλοιο ἂν ποιῆσαι;",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 12,
      "bbox": [
        349,
        89,
        360,
        597
      ],
      "margin_number": null,
      "speaker": "ΦΙΛ.",
      "text": "βουλοίμην ἂν ἔγωγε. εἰπέ μοι ταχέως, τί δεῖ με ποιεῖν;",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 13,
      "bbox": [
        363,
        89,
        375,
        715
      ],
      "margin_number": null,
      "speaker": "ΒΔΕΛ.",
      "text": "μεῖνον ἐνθάδε. ἐξοίσω γὰρ τὰ τοῦ δικαστηρίου.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "stage_direction",
      "order": 14,
      "bbox": [
        378,
        191,
        390,
        608
      ],
      "margin_number": null,
      "speaker": null,
      "text": "(ἐκφέρει μὲν τὰ σκεύη. τὸ δὲ δικαστήριον ποιεῖται.)",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 15,
      "bbox": [
        393,
        191,
        404,
        893
      ],
      "margin_number": null,
      "speaker": null,
      "text": "προσελθέτω ὁ ἀντίδικος. ἡ δὲ δίκη ἀρχέσθω. ποῦ ἐστιν ὁ κατήγορος; δεῦρο",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 16,
      "bbox": [
        408,
        191,
        419,
        888
      ],
      "margin_number": null,
      "speaker": null,
      "text": "ἐλθέ, ὦ κύον, καὶ κατηγόρησον. ἀνάβθι καὶ εἰπέ. λέγε ἡμῖν τίς καὶ τί",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 17,
      "bbox": [
        421,
        191,
        447,
        893
      ],
      "margin_number": null,
      "speaker": null,
      "text": "βουλόμενος τὴν γραφὴν ἐγράψατο. ὦ πάτερ, ἐλπίζω σε προσέξειν τὸν\nνοῦν.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 18,
      "bbox": [
        451,
        89,
        462,
        597
      ],
      "margin_number": null,
      "speaker": "ΦΙΛ.",
      "text": "μὴ φρόντιζε. ἄγε δή, ὦ κύον, εἰπὲ δή.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "heading",
      "order": 19,
      "bbox": [
        480,
