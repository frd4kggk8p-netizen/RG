      "bbox": [
        870,
        88,
        884,
        458
      ],
      "margin_number": null,
      "speaker": "DIKAIOPOLIS",
      "text": "Are you looking for a greater city than Athens?",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 28,
      "bbox": [
        886,
        88,
        927,
        908
      ],
      "margin_number": null,
      "speaker": "EUELPIDES",
      "text": "No, by Zeus, I do not mean that. There is no greater city than this one. For, in the name of Zeus, Athens is clearly the greatest.",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 29,
      "bbox": [
        930,
        88,
        944,
        668
      ],
      "margin_number": null,
      "speaker": "RHAPSODE",
      "text": "Are you looking for a wealthier city than this one?",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
