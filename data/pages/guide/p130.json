      "bbox": [
        814,
        165,
        885,
        874
      ],
      "margin_number": 11,
      "speaker": null,
      "text": "λόγῳ μέν ... ἔργῳ δέ ... ‘in word ... in deed ...’; ‘in theory ... in practice\n...’ a very frequent contrast.",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
