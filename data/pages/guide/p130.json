        816
      ],
      "margin_number": 7,
      "speaker": null,
      "text": "ὡς ἐμοὶ δοκεῖ This is the impersonal use of δοκεῖ, ‘as it seems to me’.",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
