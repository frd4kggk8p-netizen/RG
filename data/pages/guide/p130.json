        889,
        165,
        960,
        902
      ],
      "margin_number": 20,
      "speaker": null,
      "text": "καπνῷ ἐξιόντι οὐχ ὅμοιος εἶ ὅμοιος takes the dative (‘like to’): ‘You are not\nlike smoke coming out, but more like ...’",
      "lang": "mixed",
      "para_no": null,
