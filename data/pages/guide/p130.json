      "order": 7,
      "bbox": [
        739,
        166,
        810,
        874
      ],
      "margin_number": 8,
      "speaker": null,
      "text": "ἐντυχών τυγχάνω takes the dative in the sense of ‘finding’, ‘happening\nupon’, ‘meeting with’.",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
