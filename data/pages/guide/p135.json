        "instruction": null,
        "items": [
          {
            "n": "1",
            "prompt": "He is my father, a very wicked man. ἡμῖν"
          },
          {
            "n": "2",
            "prompt": "A great evil will befall you, since you are accursed. ὑμῖν, κακοδαίμοσιν οὖσιν"
          },
          {
            "n": "3",
            "prompt": "In theory no one in the city is better than your father, but in fact no one is worse. ἐν ταῖς πόλεσιν."
          },
          {
            "n": "4",
            "prompt": "Tell the spectator the plot of the play with full (all) enthusiasm. τοῖς θεαταῖς"
          },
          {
            "n": "5",
            "prompt": "We shout loudly (use great shouts). μεγάλῃ βοῇ"
          },
          {
            "n": "6",
            "prompt": "The sailors happened to be on the ships. ἐν τῷ πλοίῳ"
          },
          {
            "n": "7",
            "prompt": "We must obey those who give orders. τῷ κελεύοντι"
          },
          {
            "n": "8",
            "prompt": "What is the name of the king? τοῖς βασιλεῦσιν"
          },
          {
            "n": "9",
            "prompt": "Why do you (pl.) try to persuade me with this argument? τούτοις τοῖς λόγοις"
          },
          {
            "n": "10",
            "prompt": "On the next day the son chased his father back into the house with the big nets. τῷ μεγάλῳ δικτύῳ"
          }
        ]
      },
