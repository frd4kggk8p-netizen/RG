        156,
        597,
        608
      ],
      "margin_number": 22,
      "speaker": null,
      "text": "εὐξαμένῳ Agrees with μοι: ‘to me having prayed’.",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
