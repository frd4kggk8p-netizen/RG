      "caption": null,
      "uncertain": []
    },
    {
      "type": "paragraph",
      "order": 19,
      "bbox": [
        830,
        167,
        908,
        856
      ],
      "margin_number": 2,
      "speaker": null,
      "text": "This is a typical beginning for a speech in a lawcourt. ὦνδρες = ὦ ἄνδρες ‘gentlemen’. τοσαύτης διαβολῆς ‘such a great slander’. Do not confuse τοσοῦτος ‘so great’ with τοιοῦτος ‘of such a kind’.",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "paragraph",
      "order": 20,
      "bbox": [
        910,
        167,
        928,
        849
      ],
      "margin_number": 3,
      "speaker": null,
      "text": "γιγνώσκω αὐτὸν … γιγνώσκω is followed by accusative and participle.",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
