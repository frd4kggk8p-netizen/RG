        828,
        497
      ],
      "margin_number": null,
      "speaker": "BDEL.",
      "text": "This is it. Place the voting-pebble.",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
