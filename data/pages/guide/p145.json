      "bbox": [
        483,
        157,
        517,
        755
      ],
      "margin_number": 27,
      "speaker": null,
      "text": "ἔπαιρε σεαυτόν ‘Lift yourself up’ from αἴρω ἀρῶ ἦρα ‘I raise’. ἀνίστασο 2nd persons. imperative of ἀνίσταμαι.",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "vocab_entry",
      "order": 12,
      "bbox": [
        522,
        157,
        558,
        863
      ],
      "margin_number": 33,
      "speaker": null,
      "text": "πείσομαι Can be the future of either πάσχω or πείθομαι. See GE p. 202, #211. The context will give you the right meaning here.",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
