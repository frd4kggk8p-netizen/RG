        834,
        88,
        847,
        456
      ],
      "margin_number": null,
      "speaker": "PHIL.",
      "text": "This voting-pebble is in here.",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
