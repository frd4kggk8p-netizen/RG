      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 14,
      "bbox": [
        603,
        88,
        634,
        888
      ],
      "margin_number": null,
      "speaker": "PHILOKLEON",
      "text": "Go to hell. How bad (not good) I consider the lentil soup. For I burst into tears as I ate this lentil soup.",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 15,
      "bbox": [
        640,
        88,
        655,
        483
      ],
      "margin_number": null,
      "speaker": "BDELYKLEON",
      "text": "The dog is acquitted, then?",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 16,
      "bbox": [
        661,
        88,
        674,
        451
      ],
      "margin_number": null,
      "speaker": "PHIL.",
      "text": "It is difficult for me to know.",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 17,
      "bbox": [
        680,
        88,
        712,
        861
      ],
      "margin_number": null,
      "speaker": "BDEL.",
      "text": "Come, Daddy dear, turn to better things. Taking this voting-pebble in your hand, put it into the further voting-urn, and acquit (him), Father.",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 18,
      "bbox": [
        718,
        88,
        731,
        649
      ],
      "margin_number": null,
      "speaker": "PHIL.",
      "text": "No indeed. For I do not know how to play the lyre.",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 19,
      "bbox": [
        738,
        88,
        751,
        584
      ],
      "margin_number": null,
      "speaker": "BDEL.",
      "text": "Come now, let me take you round this way.",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "stage_direction",
      "order": 20,
      "bbox": [
        757,
        189,
        790,
        856
      ],
      "margin_number": null,
      "speaker": null,
      "text": "(So taking him round a big walkabout, he walks to the further voting-urn first.)",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
