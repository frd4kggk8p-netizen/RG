      "bbox": [
        796,
        88,
        809,
        353
      ],
      "margin_number": null,
      "speaker": "PHIL.",
      "text": "Is this the nearer?",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
