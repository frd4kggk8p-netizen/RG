        508,
        508,
        727,
        542
      ],
      "margin_number": 4,
      "speaker": null,
      "text": "On discovering the men, the women stopped worrying.\nταῦτα εἰποῦσαι αἱ γυναῖκες ἔπεισαν τοὺς νεανίας.",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
