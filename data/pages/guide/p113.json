        737,
        448
      ],
      "margin_number": 2,
      "speaker": null,
      "text": "Saying this/with these words, the sailor laughed\nεὑρόντες ταύτας τὰς γυναῖκας, οἱ νεανίαι ἐθαύμασαν.",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
