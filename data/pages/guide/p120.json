      "bbox": [
        375,
        191,
        407,
        894
      ],
      "margin_number": null,
      "speaker": null,
      "text": "For we must accept the gifts of the gods with resignation, both the bad and the better.",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
