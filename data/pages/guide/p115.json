      ],
      "margin_number": 13,
      "speaker": null,
      "text": "τυγχάνω + participle  ‘happen to be ...’",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
