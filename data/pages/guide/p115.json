      "speaker": null,
      "text": "τίς ὢν σύ ...  Note the idiomatic use of the participle, ‘Who are you to take hold of...?’",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
