{
  "running_head": "Section 9B",
  "folio": "114",
  "blocks": [
    {
      "type": "passage_line",
      "order": 1,
      "bbox": [
        91,
        79,
        137,
        891
      ],
      "margin_number": null,
      "speaker": "XANTHIAS",
      "text": "What’s the shouting? To whom are you speaking, Sosias? Wanting what do you shout thus? You will destroy me by shouting.",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 2,
      "bbox": [
        116,
        88,
        153,
        892
      ],
      "margin_number": null,
      "speaker": "SOS.",
      "text": "I’m talking to you, unlucky Xanthias, and it’s for your sake that I’m shouting. But what are you suffering?",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 3,
      "bbox": [
        156,
        89,
        170,
        369
      ],
      "margin_number": null,
      "speaker": "XAN.",
      "text": "I’m sleeping with pleasure.",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 4,
      "bbox": [
        174,
        88,
        209,
        878
      ],
      "margin_number": null,
      "speaker": "SOS.",
      "text": "You’re sleeping? But I would like to say something to you, ill-favoured man that you are, and unlucky.",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 5,
      "bbox": [
        213,
        88,
        227,
        497
      ],
      "margin_number": null,
      "speaker": "XAN.",
      "text": "What would you like to say to me?",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 6,
      "bbox": [
        231,
        88,
        283,
        878
      ],
      "margin_number": null,
      "speaker": "SOS.",
      "text": "I’d like to say to you that a great evil will befall you. For the master will kill you. So don’t sleep. Don’t you happen to know what sort of beast we are guarding?",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 7,
      "bbox": [
        287,
        88,
        301,
        408
      ],
      "margin_number": null,
      "speaker": "XAN.",
      "text": "I certainly think I know.",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 8,
      "bbox": [
        305,
        88,
        345,
        834
      ],
      "margin_number": null,
      "speaker": "SOS.",
      "text": "But these spectators here don’t know. So tell the story of the play to the spectators, who are many.",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 9,
      "bbox": [
        349,
        88,
        363,
        814
      ],
      "margin_number": null,
      "speaker": "XAN.",
      "text": "All right, I’ll tell the large number of spectators the story of our play.",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
