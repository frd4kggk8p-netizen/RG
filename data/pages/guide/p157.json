        346,
        158,
        375,
        898
      ],
      "margin_number": 32,
      "speaker": null,
      "text": "ἀμέλει This is, strictly speaking, an imperative of ἀμελέω, so ‘Never mind’, but it comes to be used as if it were an adverb: ‘of course’.",
      "lang": "mixed",
      "para_no": null,
