        725
      ],
      "margin_number": null,
      "speaker": "ΓΥΝΗ",
      "text": "κἀγὼ δὴ ἐθελήσαιμ’ ἄν. ἀλλὰ πῶς (τίνι τρόπῳ) ἔξεστιν ἡμῖν, γυναιξὶν οὖσαι, τοῦτο ποιεῖν; εἰπέ μοι ἃ ἐν νῷ ἔχεις.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
