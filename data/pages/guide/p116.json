      ],
      "margin_number": 32,
      "speaker": null,
      "text": "λέγοιμι ἄν And another.\nἀπράγμονα ἀ-πράγμων = ‘not busy’ or more often ‘not meddlesome’, or ‘trouble-free’. It is the opposite of πολυπράγμων ‘meddling’. Cf. πράττω and πρᾶγμα.",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
