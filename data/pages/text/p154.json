      "margin_number": null,
      "speaker": null,
      "text": "ἀλλ᾽ ὦ πάντες θεοί, δότε μοι τὴν γυναῖκα ἰδεῖν.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
