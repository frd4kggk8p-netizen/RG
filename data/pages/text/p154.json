      "bbox": [
        346,
        219,
        360,
        642
      ],
      "margin_number": null,
      "speaker": null,
      "text": "θεοί, οἷς εὔχομαι, δώσουσί μοι τὴν γυναῖκα ἰδεῖν.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
