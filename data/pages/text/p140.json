      "bbox": [
        269,
        126,
        296,
        314
      ],
      "margin_number": 10,
      "speaker": "ΒΔΕΛ.",
      "text": "(shouting after him)\nοὗτος, σὺ ποῖ σπεύδεις;",
      "lang": "mixed",
