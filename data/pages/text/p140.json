        314,
        126,
        326,
        718
      ],
      "margin_number": null,
      "speaker": "ΒΔΕΛ.",
      "text": "μὴ ἄπιθι μηδαμῶς, ἀλλ' ἐμοὶ πιθοῦ καὶ ἄκουσον, ὦ πάτερ.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
