      "bbox": [
        159,
        126,
        170,
        521
      ],
      "margin_number": null,
      "speaker": "ΦΙΛ.",
      "text": "πάντα δή μοι ἀρέσκει, εὖ ἴσθ' ὅτι.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 5,
      "bbox": [
        173,
        126,
        185,
        712
      ],
      "margin_number": null,
      "speaker": "ΒΔΕΛ.",
      "text": "οὐκοῦν κάθιζε, πάτερ. ἰδού· τὴν γὰρ πρώτην δίκην καλῶ.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 6,
      "bbox": [
        188,
        126,
        199,
        563
      ],
      "margin_number": null,
      "speaker": "ΦΙΛ.",
      "text": "μὴ κάλει τὴν δίκην, ὦ παῖ, ἀλλ' ἄκουσον.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 7,
      "bbox": [
        202,
        126,
        214,
        604
      ],
      "margin_number": 5,
      "speaker": "ΒΔΕΛ.",
      "text": "καὶ δὴ ἀκούω. τί λέγεις; ἴθι, ὦ πάτερ, λέξον.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 8,
      "bbox": [
        217,
        126,
        250,
        835
      ],
      "margin_number": null,
      "speaker": "ΦΙΛ.",
      "text": "ποῦ εἰσιν οἱ κάδοι; οὐ γὰρ δύναμαι τὴν ψῆφον θέσθαι ἄνευ τῶν κάδων, εὖ ἴσθ' ὅτι.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
