      "bbox": [
        253,
        126,
        266,
        368
      ],
      "margin_number": null,
      "speaker": null,
      "text": "(ἐκτρέχων ἄρχεται ὁ γέρων)",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
