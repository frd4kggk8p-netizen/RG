      "margin_number": null,
      "speaker": "ΒΔΕΛ.",
      "text": "ἆρα πάντ' ἀρέσκει σοι, πάτερ; εἰπέ μοι.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
