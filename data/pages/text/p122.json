      ],
      "margin_number": null,
      "speaker": "ΔΙΚ.",
      "text": "χαῖρε καὶ σύ γε, ὦ Πεισέταιρε. ποῖ δὴ μετ' ἐκείνου τοῦ κόρακος; μῶν εἰς κόρακας;",
      "lang": "grc",
      "para_no": null,
      "marker": null,
