      "bbox": [
        243,
        122,
        275,
        901
      ],
      "margin_number": 35,
      "speaker": "ΠΕΙΣ.",
      "text": "οὗτος μὲν ὁ κόραξ ἡγεῖται, ἡμεῖς δὲ ἑπόμεθα. τίς γὰρ ἡγεμὼν βελτίων εἰς κόρακας ἢ κόραξ;",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
