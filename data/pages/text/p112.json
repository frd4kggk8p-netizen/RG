      "speaker": null,
      "text": "It is left for Dionysodoros to confuse Kleinias further, by turning the argument on its head.",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
