      "order": 4,
      "bbox": [
        412,
        125,
        482,
        770
      ],
      "margin_number": null,
      "speaker": null,
      "text": "‘τί δέ, ὦ Κλεινία;’ ἔφη. ‘καὶ δὴ λέγει ὁ διδάσκαλος λόγους τινάς. πότεροι μανθάνουσι τοὺς λόγους, οἱ σοφοὶ ἢ οἱ ἀμαθεῖς;’",
      "lang": "grc",
      "para_no": 2,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
