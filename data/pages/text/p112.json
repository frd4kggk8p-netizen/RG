        510,
        125,
        529,
        792
      ],
      "margin_number": null,
      "speaker": null,
      "text": "‘οἱ σοφοὶ ἄρα μανθάνουσιν, ἀλλ' οὐχὶ οἱ ἀμαθεῖς, καὶ οὐκ εὖ σὺ ἄρτι ἀπεκρίνω.’",
      "lang": "grc",
      "para_no": 4,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
