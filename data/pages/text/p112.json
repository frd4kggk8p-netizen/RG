        503,
        517
      ],
      "margin_number": null,
      "speaker": null,
      "text": "‘οἱ σοφοὶ’, ἦ δ' ὅς ὁ Κλεινίας.",
      "lang": "grc",
      "para_no": 3,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
