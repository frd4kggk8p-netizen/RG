        232,
        122,
        246,
        828
      ],
      "margin_number": null,
      "speaker": "ΣΤΡΕΨ.",
      "text": "ναὶ μὰ Δία θαυμάζω. ἀλλὰ τί ποιοῦσιν οὗτοι οἱ εἰς τὴν γῆν βλέποντες;",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 7,
      "bbox": [
        247,
        122,
        267,
        901
      ],
      "margin_number": 5,
      "speaker": "ΜΑΘ.",
      "text": "ζητοῦσιν οὗτοι τὰ κατὰ γῆς.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 8,
      "bbox": [
        270,
        122,
        319,
        829
      ],
      "margin_number": null,
      "speaker": "ΣΤΡΕΨ.",
      "text": "βολβοὺς ἄρα ζητοῦσιν. μὴ νῦν τοῦτό γ’ ἔτι φροντίζετε, ὦ θηρία· ἐγὼ γὰρ οἶδα ὅπου εἰσὶ μεγάλοι καὶ καλοὶ. ἀλλὰ τίς οὗτοσί; διὰ τί ὁ πρωκτὸς εἰς τὸν οὐρανὸν βλέπει;",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 9,
      "bbox": [
        323,
        122,
        336,
        401
      ],
      "margin_number": null,
      "speaker": "ΜΑΘ.",
      "text": "διότι ἀστρονομεῖ ὁ πρωκτός.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
