      "margin_number": null,
      "speaker": "ΣΤΡΕΨ.",
      "text": "ὦ Ἡράκλεις, τίνα ταῦτα τὰ θηρία;",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
