        197,
        122,
        229,
        846
      ],
      "margin_number": null,
      "speaker": "ΜΑΘ.",
      "text": "οὗτος, διὰ τί ἐθαύμασας; διὰ τί αὖθις ἐβόησας; ἆρα τοὺς μαθητὰς τούτους θαυμάζεις;",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
