      "bbox": [
        133,
        447,
        804,
        469
      ],
      "margin_number": null,
      "speaker": "ΜΥ.",
      "text": "οὐκ ἂν ποιήσαιμι τοῦθ' ὃ λέγεις, ὦ Λυσιστράτη, ἀλλ' ὁ πόλεμος ἑρπέτω.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 16,
      "bbox": [
        123,
        475,
        903,
        551
      ],
      "margin_number": 20,
      "speaker": "ΚΛ.",
      "text": "μὰ Δί' οὐδ' ἐγὼ γάρ, ἀλλ' ὁ πόλεμος ἑρπέτω. κέλευσόν με διὰ τοῦ πυρὸς\nβαδίζειν. τοῦτο μᾶλλον ἐθελήσαιμ' ἂν ποιεῖν ἢ τῶν ἀφροδισίων\nἀπέχεσθαι. οὐδὲν γὰρ τοῖς ἀφροδισίοις ὅμοιον, ὦ φίλη Λυσιστράτη. οὐκ\nἂν ποιήσαιμι οὐδαμῶς.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
