      "order": 7,
      "bbox": [
        217,
        215,
        804,
        239
      ],
      "margin_number": null,
      "speaker": null,
      "text": "ἀναγκάσειν τοὺς ἄνδρας εἰρήνην ἄγειν, ἡμᾶς χρὴ ἀπέχεσθαι –",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
