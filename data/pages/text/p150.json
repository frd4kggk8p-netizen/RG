        122,
        387,
        888,
        410
      ],
      "margin_number": null,
      "speaker": "ΛΥ.",
      "text": "ποῖ βαδίζετε; τί δακρύετε; ποιήσετ' ἢ οὐ ποιήσετε ἃ κελεύω; ἤ τί μέλλετε;",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
