      "order": 12,
      "bbox": [
        117,
        357,
        878,
        381
      ],
      "margin_number": null,
      "speaker": null,
      "text": "(αἱ γυναῖκες πᾶσαι, ἀκούσασαι τοὺς λόγους, οὓς λέγει Λυσιστράτη, ἀπιέναι ἄρχονται)",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
