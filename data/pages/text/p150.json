      "order": 4,
      "bbox": [
        217,
        102,
        792,
        126
      ],
      "margin_number": null,
      "speaker": null,
      "text": "κἀμοὶ δοκεῖ τὸν πόλεμον καταλῦσαι. ἀλλὰ πῶς ἔξεστιν ἡμῖν, γυναιξὶν",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 5,
      "bbox": [
        217,
        128,
        878,
        178
      ],
      "margin_number": null,
      "speaker": null,
      "text": "οὖσαι; ἆρα μηχανήν τιν' ἔχεις; δεῖ γὰρ τοὺς ἄνδρας, οἳ τὰς μάχας μάχονται,\nκαταλύσαντας τὸν πόλεμον σπονδὰς ποιεῖσθαι.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
