      "bbox": [
        122,
        275,
        638,
        296
      ],
      "margin_number": null,
      "speaker": "ΛΥ.",
      "text": "ποιήσετ' οὖν ὃ κελεύω;",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
