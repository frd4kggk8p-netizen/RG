      "bbox": [
        121,
        187,
        835,
        214
      ],
      "margin_number": 10,
      "speaker": "ΛΥ.",
      "text": "λέγοιμ' ἄν. οὐ γὰρ δεῖ σιωπᾶν. ἀλλ', ὦ γυναῖκες, εἴπερ μέλλομεν",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
