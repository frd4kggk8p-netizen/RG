      "bbox": [
        133,
        248,
        775,
        269
      ],
      "margin_number": null,
      "speaker": "ΜΥ.",
      "text": "τίνος; τίς ἡ μηχανή; λέξον ἐκεῖνο ὃ ἐν νῷ ἔχεις.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
