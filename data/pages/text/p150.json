        73,
        834,
        76
      ],
      "margin_number": null,
      "speaker": "ΚΛΕΟΝΙΚΗ",
      "text": "(καὶ Κλεονίκη, ἣ ἑτέρα φίλη τυγχάνει οὖσα, ὁμολογεῖ)",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
