        351
      ],
      "margin_number": 15,
      "speaker": "ΛΥ.",
      "text": "δεῖ τοίνυν ἡμᾶς ἀπέχεσθαι τῶν ἀφροδισίων.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
