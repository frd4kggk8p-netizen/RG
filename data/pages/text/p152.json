        706
      ],
      "margin_number": 25,
      "speaker": "ΜΥ.",
      "text": "νὴ Δία ἔγνων ἔγωγε. ἔστι γὰρ Κινησίας, οὗ γυνή εἰμι ἐγώ.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
