        426,
        123,
        449,
        829
      ],
      "margin_number": null,
      "speaker": "ΚΛ.",
      "text": "ἀλλὰ δῆλον, Λυσιστράτη, ὅτι ἡ Μυρρίνη αὐτὸν ἔγνω. ἰδοῦσα γὰρ καὶ\nγνοῦσα ᾤμυξε.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
