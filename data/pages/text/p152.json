        423,
        220
      ],
      "margin_number": 20,
      "speaker": "ΜΥ.",
      "text": "οἴμοι.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
