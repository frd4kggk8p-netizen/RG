      "bbox": [
        164,
        218,
        178,
        831
      ],
      "margin_number": null,
      "speaker": null,
      "text": "τίνι τρόπῳ τοὺς ὑμετέρους δυνήσεσθε πεῖσαι, οἳ τὰς τριήρεις γ᾽ ἔχουσι",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 5,
      "bbox": [
        181,
        219,
        192,
        574
      ],
      "margin_number": null,
      "speaker": null,
      "text": "καὶ τἀργύριον; ἢ χρήμασιν ἢ δώροις ἢ ποιοῦσαι;",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 6,
      "bbox": [
        198,
        123,
        210,
        169
      ],
      "margin_number": null,
      "speaker": "ΛΥ.",
      "text": "ἀλλὰ καὶ τοῦτ᾽ εὖ παρεσκευασάμεθα, ὅτι καταληψόμεθα τήμερον τὴν",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 7,
      "bbox": [
        214,
        219,
        239,
        903
      ],
      "margin_number": 5,
      "speaker": null,
      "text": "ἀκρόπολιν, θύειν δοκοῦσαι. καταλαβοῦσαι δέ, φυλάξομεν αὐτὴν αὐτῷ\nτῷ ἀργυρίῳ.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "stage_direction",
      "order": 8,
      "bbox": [
        242,
        122,
        253,
        834
      ],
      "margin_number": null,
      "speaker": null,
      "text": "(boῄ tina eżaifnჳs akoჳei h lampitw, akoჳsasa de thn lysistrATHN PROSAGOREῠEI)",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 9,
      "bbox": [
        257,
        124,
        269,
        526
      ],
      "margin_number": null,
      "speaker": "ΛΑΜ.",
      "text": "τίς ἐβόησε; τίς αἴτιος τῆς βοῆς;",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 10,
      "bbox": [
        273,
        124,
        283,
        168
      ],
      "margin_number": null,
      "speaker": "ΛΥ.",
      "text": "τοῦτ᾽ ἐκεῖνο ὃ ἔλεγον. αἱ γὰρ γρᾶες, ἃς ἔδει τὴν ἀκρόπολιν τῆς θεοῦ",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 11,
      "bbox": [
        287,
        219,
        313,
        903
      ],
      "margin_number": 10,
      "speaker": null,
      "text": "καταλαβεῖν, νῦν ἔχουσιν. ἀλλ᾽ ὦ Λαμπιτοῖ, σὺ μὲν, οἴκαδε ἐλθοῦσα, τὰ\nπαρ᾽ ὑμῖν εὖ θέσις, ἡμεῖς δ᾽ εἰσελθοῦσαι τὴν ἀκρόπολιν, ἣν ἄρτι κατέλαβον\nαἱ γρᾶες, φυλάξομεν.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "stage_direction",
      "order": 12,
      "bbox": [
        326,
        124,
        351,
        885
      ],
      "margin_number": null,
      "speaker": null,
      "text": "(ἡ μὲν Λαμπιτὼ ἀπιοῦσα βαδίζει τὴν ὁδόν, ἣ εἰς Λακεδαίμονα φέρει, αἱ δ᾽ ἄλλαι\nεἰσελθοῦσαι τὴν ἀκρόπολιν φυλάττουσιν. ἐξαίφνης δὲ βοᾷ ἡ Λυσιστράτη, ἰδοῦσα\nἄνδρα τινά, ὃς τυγχάνει προσιών.)",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 13,
      "bbox": [
        355,
        124,
        366,
        477
      ],
      "margin_number": 15,
      "speaker": "ΛΥ.",
      "text": "ἰοὺ ἰοὺ γυναῖκες, ἴτε δεῦρο ὡς ἐμὲ ταχέως.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 14,
      "bbox": [
        369,
        123,
        381,
        417
      ],
      "margin_number": null,
      "speaker": "ΚΛ.",
      "text": "τί δ᾽ ἐστίν; εἰπέ μοι, τίς ἡ βοή;",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 15,
      "bbox": [
        384,
        123,
        408,
        831
      ],
      "margin_number": null,
      "speaker": "ΛΥ.",
      "text": "ἄνδρα ἄνδρα ὁρῶ προσιόντα. ὁρᾶτε. γιγνώσκει τις ὑμῶν τὸν ἄνδρα ὃς\nπροσέρχεται;",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
