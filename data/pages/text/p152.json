      ],
      "margin_number": null,
      "speaker": "ΛΑΜ.",
      "text": "ἡμεῖς οὖν, τοὺς ἡμετέρους ἄνδρας πείσασαι, ἀναγκάσομεν εἰρήνην ἄγειν.",
      "lang": "grc",
