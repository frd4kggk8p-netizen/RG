        222,
        461,
        828
      ],
      "margin_number": null,
      "speaker": null,
      "text": "ἐμπεσών, αὐτῷ τῷ τυμπάνῳ ἐδίκασεν. ἐντεῦθεν ἔνδον ἐγκλείσαντες",
      "lang": "grc",
