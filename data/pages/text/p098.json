      ],
      "margin_number": 20,
      "speaker": "ΣΩΚ.",
      "text": "οὐδέποτε εἶδες σύ γε πρᾶγμα οὕτω σοφόν; ἀλλὰ πόθεν ὢν τυγχάνεις;",
      "lang": "grc",
      "para_no": null,
