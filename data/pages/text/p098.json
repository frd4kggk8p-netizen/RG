      ],
      "margin_number": null,
      "speaker": null,
      "text": "(ἀπέρχεται ὁ μαθητής. ὁ Στρεψιάδης τὸν Σωκράτη καλεῖ.)",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
