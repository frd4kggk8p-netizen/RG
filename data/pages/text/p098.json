      "bbox": [
        170,
        123,
        185,
        761
      ],
      "margin_number": null,
      "speaker": "ΣΩΚ.",
      "text": "τίς ἐβόησε; τίς ἐβιάσατο εἰς τὸ φροντιστήριον τὸ τῶν σοφιστῶν;",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 5,
      "bbox": [
        187,
        123,
        222,
        723
      ],
      "margin_number": 5,
      "speaker": "ΣΤΡΕΨ.",
      "text": "ἐβόησα ἐγώ, Στρεψιάδης Κικυννόθεν. ἀλλ᾽ οὐκ ἐβιασάμην εἰς τὸ φροντιστήριον.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 6,
      "bbox": [
        225,
        123,
        239,
        617
      ],
      "margin_number": null,
      "speaker": "ΣΩΚ.",
      "text": "τί με καλεῖς, ὦ ἐφήμερε; ἦλθες δὲ σὺ κατὰ τί;",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 7,
      "bbox": [
        242,
        123,
        257,
        820
      ],
      "margin_number": null,
      "speaker": "ΣΤΡΕΨ.",
      "text": "ἦλθον μαθητὴς εἰς τὸ φροντιστήριον. ἤδη γάρ σε ἤκουσα ὡς εἶ σοφός.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 8,
      "bbox": [
        259,
        123,
        273,
        718
      ],
      "margin_number": null,
      "speaker": "ΣΩΚ.",
      "text": "εἰπέ μοι, τίς εἶπε τοῦτο; πῶς δ᾽ ἤκουσάς με ὡς σοφός εἰμι;",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 9,
      "bbox": [
        275,
        123,
        291,
        469
      ],
      "margin_number": null,
      "speaker": "ΣΤΡΕΨ.",
      "text": "εἶπε τοῦτο τῶν μαθητῶν τις.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 10,
      "bbox": [
        294,
        123,
        308,
        506
      ],
      "margin_number": 10,
      "speaker": "ΣΩΚ.",
      "text": "τί δ᾽ εἶπεν ὁ μαθητής; λέγε.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 11,
      "bbox": [
        311,
        123,
        383,
        860
      ],
      "margin_number": null,
      "speaker": "ΣΤΡΕΨ.",
      "text": "εἶπε γὰρ ὁ μαθητὴς ὡς ψύλλα τις ἔδακε τὴν Χαιρεφῶντος ὀφρῦν. εἶτα ἐπὶ τὴν σὴν κεφαλὴν ἐπήδησε. σὺ δὲ τὸν Χαιρεφῶντα ἤρου ὁπόσους ἐκ αὐτῆς πόδας ἐπήδησεν ἡ ψύλλα. ἀν-εμετρήσατε δ᾽ ὑμεῖς οὕτως· πρῶτον μὲν γὰρ τὴν ψύλλαν ἐλάβετε καὶ ἔθετε εἰς κηρὸν θερμόν. ἐπειδὴ δὲ ψυχρὸς ἐγένετο ὁ κηρός, ἡ ψύλλα ἔσχεν ἐμβάδας τινὰς Περσικάς. εἶτα δ᾽ ἀν-εμετρήσατε τὸ χωρίον.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "stage_direction",
      "order": 12,
      "bbox": [
        386,
        222,
        400,
        452
      ],
