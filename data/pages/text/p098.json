        153,
        123,
        168,
        638
      ],
      "margin_number": null,
      "speaker": "ΣΤΡΕΨ.",
      "text": "ὦ Σώκρατες, ὦ Σωκρατίδιον, δεῦρ᾽ ἐλθέ.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
