        338,
        775
      ],
      "margin_number": null,
      "speaker": "ΣΩΚ.",
      "text": "ὅ τι; πρῶτον μὲν κατακλίνῃ ἐπὶ τῆς κλίνης. ἔπειτα ἐκφρόντιζέ τι τῶν\nσεαυτοῦ πραγμάτων.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
