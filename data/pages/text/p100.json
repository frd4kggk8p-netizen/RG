      ],
      "margin_number": null,
      "speaker": "ΣΤΡΕΨ.",
      "text": "ἀλλ' ὦ Σωκρατίδιον, τί οὐ καταβαίνεις; ἦλθον γὰρ ἐγὼ εἰς τὸ\nφροντιστήριον διότι, χρήματα πολλὰ ὀφείλων, ὑπόχρεώς εἰμι.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 3,
      "bbox": [
        161,
        127,
        175,
        715
      ],
      "margin_number": null,
      "speaker": "ΣΩΚ.",
      "text": "ἀλλὰ πῶς σὺ ὑπόχρεως ἐγένου; πῶς τοῦτο πάσχεις;",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 4,
      "bbox": [
        178,
        127,
        230,
        903
      ],
      "margin_number": 5,
      "speaker": "ΣΤΡΕΨ.",
      "text": "ἔλαθον ἐμαυτόν ἱππομανῆ τὸν υἱὸν ἔχων. ὑπόχρεως οὖν ἐγενόμην.\nκαὶ τοῦτο ἔπαθον διὰ τὴν ἱππικὴν καὶ διὰ τὸν ἐμὸν υἱόν. ἀεὶ γὰρ δίκας\nλαμβάνουσιν οἱ χρῆσται, καὶ εἰ μή τι ποιήσω, εἰς ἀεὶ λήψονται. δίδασκε\nοὖν με τὸν ἕτερον τῶν σῶν λόγων.",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 5,
      "bbox": [
        235,
        127,
        248,
        868
      ],
      "margin_number": null,
      "speaker": "ΣΩΚ.",
      "text": "τὸν ἕτερον τῶν ἐμῶν λόγων; πότερον λέγεις; τὸν κρείττονα ἢ τὸν ἥττονα;",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 6,
      "bbox": [
        252,
        127,
        285,
        904
      ],
      "margin_number": 10,
      "speaker": "ΣΤΡΕΨ.",
      "text": "τὸν ἄδικον λέγω, τὸν ἥττονα, τὸν τὰ χρέα παύοντα. οὗτος γὰρ ὁ λόγος\nτὰς δίκας νικήσει, ὁ κρείττων δ' οὔ. τί δράσω;",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "stage_direction",
      "order": 7,
      "bbox": [
        291,
        125,
        305,
        342
      ],
      "margin_number": null,
      "speaker": null,
      "text": "(points to a couch)",
      "lang": "en",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
