    },
    {
      "type": "passage_line",
      "order": 14,
      "bbox": [
        602,
        122,
        634,
        617
      ],
      "margin_number": 25,
      "speaker": "ΦΙΛ.",
      "text": "(feels his resolve breaking)\nαἰβοῖ. τί κακόν πót’ ἐστὶ τόδε; κακόν τι περιβαίνει με, καὶ ὁ λέγων με\nπείθει τοῖς λόγοις.",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
      "type": "passage_line",
      "order": 15,
      "bbox": [
        645,
        122,
        715,
        831
      ],
      "margin_number": 30,
      "speaker": "ΒΔΕΛ.",
      "text": "(still pleading)\nἴθ’ ἀντιβολῶ σε, οἰκτίρατε αὐτόν, ὦ πάτερ, κακὰ παθόντα, καὶ\nἀπολύσατε. ποῦ τὰ παιδία; ἀναβαίνετε, ὦ πονηρά, αἰτεῖτε καὶ ἀντιβολείτε\nδακρύοντα.",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
    {
