        576
      ],
      "margin_number": null,
      "speaker": "ΦΙΛ.",
      "text": "(exasperated)\nκατάβηθι, κατάβηθι, κατάβηθι, κατάβηθι.",
      "lang": "mixed",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
