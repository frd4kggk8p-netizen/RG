      "bbox": [
        397,
        120,
        427,
        781
      ],
      "margin_number": null,
      "speaker": null,
      "text": "καὶ ὁ Εὐθύδημος, ‘ἀλλὰ τίς διδάσκει τοὺς μανθάνοντας’, ἔφη, ‘ὁ διδάσκαλος, ἢ\nἄλλος τις;’",
      "lang": "grc",
      "para_no": null,
      "marker": null,
      "table": null,
      "exercise": null,
      "caption": null,
      "uncertain": []
    },
